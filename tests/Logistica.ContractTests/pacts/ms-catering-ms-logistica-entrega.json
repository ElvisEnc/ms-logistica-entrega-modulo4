{
  "consumer": {
    "name": "ms-catering"
  },
  "interactions": [
    {
      "description": "una incidencia de entrega",
      "pending": false,
      "providerStates": [
        {
          "name": "una entrega tuvo una incidencia sin foto"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/pact-provider/incidencia"
      },
      "response": {
        "body": {
          "content": {
            "contratoCateringId": "55555555-5555-5555-5555-555555555555",
            "descripcion": "No se encontro la direccion registrada",
            "fechaHora": "2026-03-10T13:30:00Z",
            "motivo": "DIRECCION_NO_ENCONTRADA",
            "pacienteId": "44444444-4444-4444-4444-444444444444",
            "pacienteNombre": "Paciente De Prueba",
            "paqueteId": "33333333-3333-3333-3333-333333333333",
            "paradaId": "22222222-2222-2222-2222-222222222222",
            "rutaId": "11111111-1111-1111-1111-111111111111",
            "urlFoto": null
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.contratoCateringId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.descripcion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.fechaHora": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.motivo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(PACIENTE_AUSENTE|DIRECCION_NO_ENCONTRADA|PAQUETE_DANADO|RECHAZADO_POR_PACIENTE|OTRO)$"
                }
              ]
            },
            "$.pacienteId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pacienteNombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.paqueteId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.paradaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.rutaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.urlFoto": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "null"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ms-logistica-entrega"
  }
}